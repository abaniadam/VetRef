{
  "name": "vetref",
  "version": "1.0.0",
  "private": true,
  "description": "VetRef - مرجع علائم حیاتی و آزمایش‌ها",
  "scripts": {
    "font": "node scripts/font.js",
    "icons": "python3 scripts/icons.py",
    "android:add": "npx cap add android",
    "sync": "npx cap sync android",
    "open": "npx cap open android",
    "build:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "build:release": "npm run sync && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5",
    "@fontsource/vazirmatn": "^5.0.0"
  }
}
